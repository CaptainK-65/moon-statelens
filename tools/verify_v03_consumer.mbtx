///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
/// Source uses an isolated workspace; public mode must download the exact version.
/// Both modes compile the SAME committed consumer source and all new API branches.
async fn main {
  let (mode, target, version) = match @env.args() {
    [_, "source", target] => ("source", target, "0.3.0")
    [_, "public", target, "0.3.0"] => ("public", target, "0.3.0")
    _ => fail("expected source BACKEND | public BACKEND 0.3.0")
  }
  if !["wasm", "wasm-gc", "js", "native"].contains(target) {
    fail("invalid backend")
  }
  let root = @fs.realpath(".")
  let dir = "_build/v03-consumer-" +
    mode +
    "-" +
    target +
    "-" +
    @env.now().to_string()
  let consumer = dir + "/consumer"
  @fs.mkdir(consumer, recursive=true)
  for name in ["moon.mod", "moon.pkg", "core.mbt", "main.mbt"] {
    @fs.write_file(
      consumer + "/" + name,
      @fs.read_file("consumers/behavior-gate/" + name),
    )
  }
  if target != "native" {
    @fs.write_file(
      consumer + "/moon.pkg",
      "import {\n  \"CaptainK-65/moon-statelens\" @lens,\n}\n\npkgtype(kind: \"executable\")\n",
    )
    @fs.write_file(
      consumer + "/main.mbt",
      "///|\nfn main raise {\n  verify_core()\n}\n",
    )
  }
  let commands = []
  async fn run(args : Array[String], cwd : String) -> String {
    let result = @shell.Cmd("moon", args, cwd~).output(
      timeout_ms=180000,
      max_output_bytes=8388608,
    )
    commands.push(
      Json::object({
        "arguments": Json(args),
        "exit_code": Json(result.exit_code()),
      }),
    )
    @fs.write_file(dir + "/commands.json", Json(commands).stringify(indent=2))
    @fs.write_file(
      dir + "/stage-" + commands.length().to_string() + ".log",
      result.stdout() + result.stderr(),
    )
    if result.exit_code() != 0 {
      fail("v0.3 consumer failed; see " + dir + ": " + result.stderr())
    }
    result.stdout()
  }
  if mode == "source" {
    @fs.write_file(
      dir + "/moon.work",
      "members = [\n  " +
      Json(root).stringify() +
      ",\n  " +
      Json(@fs.realpath(consumer)).stringify() +
      ",\n]\n",
    )
  }
  ignore(run(["update"], consumer))
  ignore(run(["fmt", "--check"], consumer))
  let output = run(["run", ".", "--target", target, "--deny-warn"], consumer)
  if !output.contains("v0.3 core consumer ok") ||
    (target == "native" && !output.contains("v0.3 native consumer ok")) {
    fail("consumer did not finish")
  }
  if mode == "public" {
    let installed = @fs.read_file(
      consumer + "/.mooncakes/CaptainK-65/moon-statelens/moon.mod",
    ).text()
    if !installed.contains("version = \"" + version + "\"") {
      fail("unexpected public version")
    }
  }
  @fs.write_file(
    dir + "/receipt.json",
    Json::object({
      "mode": Json(mode),
      "target": Json(target),
      "version": Json(version),
      "scope": Json(
        if mode == "public" {
          "actual registry download; new core/native APIs"
        } else {
          "candidate source workspace; not publication evidence"
        },
      ),
      "passed": Json(true),
      "commands": Json(commands),
    }).stringify(indent=2) +
    "\n",
  )
  println(
    "v0.3 " + mode + " consumer verified on " + target + "; receipt: " + dir,
  )
}

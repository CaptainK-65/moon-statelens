///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}

///|
/// Fresh modules download the explicitly selected PUBLIC registry package, not the checkout.
async fn main {
  let args = @env.args()
  let (target, version) = match args {
    [_, target, version] => (target, version)
    _ => fail("expected BACKEND VERSION, e.g. wasm 0.2.1")
  }
  if !["wasm", "wasm-gc", "js", "native"].contains(target) {
    fail("unsupported backend")
  }
  if version.is_empty() ||
    version.contains("/") ||
    version.contains("\\") ||
    version.contains("\"") ||
    version.contains("\n") ||
    version.contains("\r") {
    fail("invalid registry version")
  }
  let dir = "_build/published-consumer-" + target + "-" + @env.now().to_string()
  @fs.mkdir(dir, recursive=true)
  let runtime = if target == "native" {
    "  \"moonbitlang/async@0.22.5\",\n"
  } else {
    ""
  }
  @fs.write_file(
    dir + "/moon.mod",
    "name = \"validation/statelens-consumer\"\npreferred_target = \"" +
    target +
    "\"\nimport {\n  \"CaptainK-65/moon-statelens@" +
    version +
    "\",\n" +
    runtime +
    "}\n",
  )
  let imports = if target == "native" {
    "  \"CaptainK-65/moon-statelens/runner\",\n" +
    "  \"CaptainK-65/moon-statelens/adapters/native\" @external,\n" +
    "  \"moonbitlang/async\",\n"
  } else {
    ""
  }
  @fs.write_file(
    dir + "/moon.pkg",
    "import {\n  \"CaptainK-65/moon-statelens\" @lens,\n" +
    imports +
    "}\npkgtype(kind: \"executable\")\n" +
    (if target == "native" { "supported_targets = \"+native\"\n" } else { "" }),
  )
  let shared =
    #|///|
    #|fn target(buggy : Bool) -> @lens.System {
    #|  let active = [false]
    #|  @lens.System::new(reset=() => active[0] = false, step=input => match input {
    #|    "login" => { active[0] = true; "ok" }
    #|    "logout" => { if !buggy { active[0] = false }; "ok" }
    #|    _ => if active[0] { "allowed" } else { "denied" }
    #|  })
    #|}
    #|
    #|///|
    #|fn verify_core() -> Unit raise {
    #|  let alphabet = ["login", "logout", "request"]
    #|  for algorithm in [@lens.Algorithm::LStar, @lens.Algorithm::KearnsVazirani] {
    #|    let experiment = @lens.Experiment::new(target(false), alphabet)
    #|    let learned = @lens.learn_with(experiment, @lens.Oracle::wp_method(2), algorithm)
    #|    guard learned.status is Supported(ConditionalStateBound(2)) else { fail("published learner did not complete") }
    #|    let model = learned.model.unwrap()
    #|    assert_eq(model.state_count(), 2)
    #|    assert_true(@lens.distinguish(model, @lens.decode_model(model.encode())) is None)
    #|  }
    #|  let comparison = @lens.compare(@lens.Experiment::new(target(false), alphabet), @lens.Experiment::new(target(true), alphabet), @lens.Oracle::w_method(2), @lens.Oracle::w_method(2))
    #|  guard comparison.status is ConfirmedDifference(diff) else { fail("published comparison did not confirm difference") }
    #|  assert_eq(diff.inputs, ["login", "logout", "request"])
    #|  assert_eq(diff.left_outputs, ["ok", "ok", "denied"])
    #|  assert_eq(diff.right_outputs, ["ok", "ok", "allowed"])
    #|  assert_true(comparison.left_statistics.resets > comparison.left.statistics.resets)
    #|  println("published consumer ok")
    #|}
  let main = if target == "native" {
    (
      #|///|
      #|async fn main {
      #|  verify_core()
      #|  @external.with_sqlite("sqlite3", system => {
      #|    let experiment = @runner.AsyncExperiment::new(system,
      #|      ["begin", "put", "delete", "commit", "rollback", "read"])
      #|    assert_eq(experiment.query(["begin", "put", "rollback", "read"]),
      #|      ["ok", "ok", "ok", "empty"])
      #|    assert_eq(experiment.query(["read"], bypass_cache=true), ["empty"])
      #|  })
      #|  println("published native adapter ok")
      #|}
    )
  } else {
    (
      #|///|
      #|fn main raise { verify_core() }
    )
  }
  @fs.write_file(dir + "/main.mbt", shared + "\n" + main + "\n")
  @shell.Cmd("moon", ["update"], cwd=dir).output(timeout_ms=60000).check()
  let output = @shell.Cmd("moon", ["run", ".", "--target", target], cwd=dir).output(
    timeout_ms=120000,
    max_output_bytes=4194304,
  )
  if output.exit_code() != 0 {
    fail("published consumer failed: " + output.stderr() + output.stdout())
  }
  if !output.stdout().contains("published consumer ok") ||
    (
      target == "native" &&
      !output.stdout().contains("published native adapter ok")
    ) {
    fail("consumer did not finish")
  }
  let installed = @fs.read_file(
    dir + "/.mooncakes/CaptainK-65/moon-statelens/moon.mod",
  ).text()
  if !installed.contains("version = \"" + version + "\"") {
    fail("unexpected installed version")
  }
  println(
    "Registry package CaptainK-65/moon-statelens@" +
    version +
    " verified on " +
    target,
  )
}

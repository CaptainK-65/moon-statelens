----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
async fn main {
  let (mode, target) = match @env.args() {
    [_, mode, target] => (mode, target)
    _ => fail("expected source|public BACKEND")
  }
  if !["source", "public"].contains(mode) ||
    !["wasm", "wasm-gc", "js", "native"].contains(target) {
    fail("invalid mode/backend")
  }
  let dir = "_build/evolution-consumer-" +
    mode +
    "-" +
    target +
    "-" +
    @env.now().to_string()
  let consumer = dir + "/consumer"
  @fs.mkdir(consumer, recursive=true)
  @fs.write_file(
    consumer + "/moon.mod",
    "name = \"examples/evolution-consumer\"\n

----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/async@0.22.5/shell",
}
----

///|
/// moon info keeps the module's wasm canonical backend. Native-only interfaces
/// are emitted in _build; copy those compiler-produced bytes without editing.
async fn main {
  @shell.Cmd("moon", ["info", "--target", "native"])
  .output(timeout_ms=120000, max_output_bytes=4194304)
  .check()
  for
    (directory, basename) in [
      ("runner", "runner"),
      ("integration", "integration"),
      ("adapters/native", "native"),
      ("cmd/fixture", "fixture"),
      ("cmd/http_fixture", "http_fixture"),
      ("cmd/statelens", "statelens"),
    ] {
    let source = "_build/native/debug/check/" +
      directory +
      "/" +
      basename +
      ".mbti"
    let target = directory + "/pkg.generated.mbti"
    let data = @fs.read_file(source)
    @fs.write_file(target, data)
  }
  println(
    "Native interface snapshots regenerated from moon info compiler output",
  )
}

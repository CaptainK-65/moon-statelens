----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/async@0.22.5/shell",
}
----

///|
async fn main {
  @shell.Cmd("moon", [
    "build", "examples/evolution", "--target", "js", "--release", "--deny-warn",
  ])
  .output()
  .check()
  @shell.Cmd("moon", [
    "build", "examples/browser", "--target", "js", "--release", "--deny-warn",
  ])
  .output()
  .check()
  let lab = @fs.read_file("_build/js/release/build/examples/browser/browser.js").text()
  let program = @fs.read_file(
    "_build/js/release/build/examples/evolution/evolution.js",
  ).text()
  if !@fs.exists("docs/demo") {
    @fs.mkdir("docs/demo", recursive=true)
  }
  let shell = @fs.read_file("examples/evolution/shell.html").text()
  let revision = @shell.Cmd("git", ["rev-parse", "HEAD"])
    .output()
    .stdout()
    .trim()
    .to_owned()
  let dirty = !@shell.Cmd("git", ["status", "--porcelain"])
    .output()
    .stdout()
    .trim()
    .is_empty()
  let workbench = @fs.read_file("examples/evolution/workbench.html")
    .text()
    .replace(
      old="/* BUILD_PROVENANCE */null",
      new=Json::object({
        "base_commit": Json(revision),
        "working_tree_dirty": Json(dirty),
      }).stringify(),
    )
  let license = @fs.read_file("LICENSE")
    .text()
    .replace(old="&", new="&amp;")
    .replace(old="<", new="&lt;")
    .replace(old=">", new="&gt;")
  @fs.write_file(
    "docs/demo/index.html",
    shell
    .replace(old="</main>", new=workbench + "</main>")
    .replace(old="<!-- APACHE_LICENSE -->", new=license)
    .replace(old="/* MOONBIT_PROGRAM */", new=program)
    .replace(old="/* LAB_PROGRAM */", new=lab),
  )
  println("Built self-contained browser demo from actual MoonBit executable")
}
